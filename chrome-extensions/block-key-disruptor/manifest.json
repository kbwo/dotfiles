{
  "manifest_version": 3,
  "name": "Block Key Disruptor",
  "version": "1.1",
  "description": "Remove all keydown event listeners set by the website on both window and document objects",
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://app.devin.ai/*",
        "https://*.slack.com/*",
        "https://www.youtube.com/*",
        "https://feedly.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ]
}
